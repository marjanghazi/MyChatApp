{
  "name": "mychatapp",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "start:backend": "bash scripts/start-python-backend.sh",
    "start:frontend": "npm --prefix frontend start",
    "backend": "npm run start:backend",
    "frontend": "npm run start:frontend",
    "start:pqc": "npm run start:frontend",
    "build:pqc": "npm --prefix frontend run build",
    "tunnel": "bash scripts/start-ngrok.sh",
    "dev": "npm run dev:pqc",
    "dev:pqc": "bash -c 'npm run start:backend & backend_pid=$!; trap \"kill $backend_pid 2>/dev/null || true\" EXIT INT TERM; npm run start:pqc'"
  }
}
