PORT=4000
CORS_ORIGINS=http://localhost:3000
# Optional local fallback storage folder when Firebase Storage is unavailable.
LOCAL_MEDIA_ROOT=./local_media

# Firebase Admin SDK
FIREBASE_PROJECT_ID=mychatapp-bf8a9
FIREBASE_CLIENT_EMAIL=your-service-account@mychatapp-bf8a9.iam.gserviceaccount.com
# Either default bucket format works:
#   my-project.firebasestorage.app  (new projects)
#   my-project.appspot.com          (legacy/default)
FIREBASE_STORAGE_BUCKET=mychatapp-bf8a9.appspot.com
# Replace literal newlines with \n when storing this in .env
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Firebase Web API key from Firebase Console -> Project settings -> Web app -> firebaseConfig.apiKey
FIREBASE_WEB_API_KEY=
# Optional fallback names also supported:
# FIREBASE_API_KEY=
# REACT_APP_FIREBASE_API_KEY=
