PORT=4000
CORS_ORIGINS=http://localhost:3000
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=quantx_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-your-local-password
# Generate locally: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_TTL_MINUTES=60

# Direct messages always require the selected E2EE suite.
E2EE_REQUIRED=true

LOCAL_MEDIA_ROOT=./local_media
POSTGRES_POOL_MIN=1
POSTGRES_POOL_MAX=12
