rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function inPath(uid) {
      return request.auth.uid == uid;
    }

    match /attachments/{conversationId}/{fileName} {
      allow read, write: if signedIn();
    }

    match /avatars/{uid}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() && inPath(uid);
    }

    match /logos/{uid}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() && inPath(uid);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
