# Development: leave empty and use the React /api proxy.
# Deployment: set the public Python-backend origin, or configure a same-origin /api proxy.
REACT_APP_API_BASE_URL=

# pqc: ML-KEM-768 + ML-DSA-65; classical: X25519 + Ed25519
# Restart/rebuild the React app after changing this value.
REACT_APP_CRYPTO_SUITE=pqc
